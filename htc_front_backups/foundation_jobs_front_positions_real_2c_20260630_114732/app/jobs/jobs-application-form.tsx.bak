"use client"

import { useMemo, useState } from "react"
import type { ChangeEvent, FormEvent } from "react"

type ApplicationData = {
  request_type: string
  selected_option: string
  experience_years: string
  first_name: string
  last_name: string
  email: string
  phone: string
  whatsapp: string
  city: string
  state: string
  preferred_location: string
  availability: string
  work_authorization: string
  message: string
  resume: File | null
}

const initialData: ApplicationData = {
  request_type: "Instructor",
  selected_option: "",
  experience_years: "",
  first_name: "",
  last_name: "",
  email: "",
  phone: "",
  whatsapp: "",
  city: "",
  state: "",
  preferred_location: "",
  availability: "",
  work_authorization: "",
  message: "",
  resume: null,
}

const temporaryOptions = [
  "English Instructor",
  "Healthcare Instructor",
  "Technology Instructor",
  "Customer Service",
  "Administrative Assistant",
  "Office Support",
  "Program Coordinator",
  "Volunteer Support",
]

export default function JobsApplicationForm() {
  const [step, setStep] = useState(1)
  const [formData, setFormData] = useState<ApplicationData>(initialData)
  const [status, setStatus] = useState<"idle" | "submitting" | "success" | "error">("idle")
  const [message, setMessage] = useState("")

  const progressWidth = useMemo(() => {
    if (step === 1) return "33%"
    if (step === 2) return "66%"
    return "100%"
  }, [step])

  const updateField = (field: keyof ApplicationData, value: string) => {
    setFormData((current) => ({ ...current, [field]: value }))
  }

  const handleFile = (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0] ?? null
    setFormData((current) => ({ ...current, resume: file }))
  }

  const validateStep = () => {
    if (step === 1) {
      return Boolean(formData.request_type && formData.selected_option && formData.experience_years)
    }

    if (step === 2) {
      return Boolean(formData.first_name && formData.last_name && formData.email && formData.phone && formData.city && formData.state)
    }

    return Boolean(formData.work_authorization && formData.availability)
  }

  const goNext = () => {
    setMessage("")

    if (!validateStep()) {
      setStatus("error")
      setMessage("Please complete the required fields before continuing.")
      return
    }

    setStatus("idle")
    setStep((current) => Math.min(current + 1, 3))
  }

  const goBack = () => {
    setMessage("")
    setStatus("idle")
    setStep((current) => Math.max(current - 1, 1))
  }

  const submitApplication = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    setMessage("")

    if (!validateStep()) {
      setStatus("error")
      setMessage("Please complete the required fields before submitting.")
      return
    }

    const payload = new FormData()
    payload.append("request_type", formData.request_type)
    payload.append("selected_option", formData.selected_option)
    payload.append("experience_years", formData.experience_years)
    payload.append("first_name", formData.first_name)
    payload.append("last_name", formData.last_name)
    payload.append("full_name", `${formData.first_name} ${formData.last_name}`.trim())
    payload.append("email", formData.email)
    payload.append("phone", formData.phone)
    payload.append("whatsapp", formData.whatsapp)
    payload.append("city", formData.city)
    payload.append("state", formData.state)
    payload.append("preferred_location", formData.preferred_location)
    payload.append("availability", formData.availability)
    payload.append("work_authorization", formData.work_authorization)
    payload.append("message", formData.message)

    if (formData.resume) {
      payload.append("cv", formData.resume)
    }

    setStatus("submitting")

    try {
      const response = await fetch("https://hudsontrainingcenter.com/api/foundation/job-applications", {
        method: "POST",
        headers: {
          Accept: "application/json",
        },
        body: payload,
      })

      const result = await response.json().catch(() => null)

      if (!response.ok || !result?.ok) {
        throw new Error(result?.message || "The application could not be submitted.")
      }

      setStatus("success")
      setMessage("Your application was submitted successfully. Our team will contact you if your profile matches an opportunity.")
      setFormData(initialData)
      setStep(1)
    } catch (error) {
      setStatus("error")
      setMessage(error instanceof Error ? error.message : "The application could not be submitted.")
    }
  }

  return (
    <div className="bg-white rounded-[44px] p-6 md:p-10 shadow-sm">
      <form onSubmit={submitApplication}>
        <div className="flex items-center justify-between mb-8 border-b border-gray-100 pb-6 relative">
          <div className="absolute bottom-0 left-0 h-1 bg-[#0073aa] transition-all duration-300" style={{ width: progressWidth }} />

          {[1, 2, 3].map((item) => (
            <div key={item} className="flex flex-col items-center flex-1">
              <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold mb-2 z-10 ${step >= item ? "bg-[#0073aa] text-white" : "bg-gray-200 text-gray-500"}`}>
                {item}
              </div>
              <span className={`text-xs font-semibold text-center ${step >= item ? "text-[#0073aa]" : "text-gray-400"}`}>
                {item === 1 ? "Profile Type" : item === 2 ? "Personal Information" : "Resume & Availability"}
              </span>
            </div>
          ))}
        </div>

        {step === 1 && (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-[#00139b] mb-6">Application Type</h2>

            <div>
              <label className="block text-gray-700 mb-3">How would you like to be part of our team?</label>
              <div className="flex flex-col sm:flex-row border border-gray-200 rounded-xl overflow-hidden bg-white">
                {["Instructor", "Staff", "Office"].map((type) => (
                  <label key={type} className="flex-1 p-4 border-b sm:border-b-0 sm:border-r last:border-r-0 border-gray-200 hover:bg-gray-50 cursor-pointer flex items-center">
                    <input
                      type="radio"
                      name="request_type"
                      value={type}
                      checked={formData.request_type === type}
                      onChange={(event) => updateField("request_type", event.target.value)}
                      className="mr-3"
                    />
                    <span>{type}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label className="block text-gray-700 mb-2">Select an option</label>
              <select
                value={formData.selected_option}
                onChange={(event) => updateField("selected_option", event.target.value)}
                className="w-full border border-gray-300 rounded-xl px-4 h-12 text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#0073aa]"
              >
                <option value="">Please choose an option</option>
                {temporaryOptions.map((option) => (
                  <option key={option} value={option}>{option}</option>
                ))}
              </select>
              <p className="text-xs text-gray-500 mt-2">This list is ready to be connected to the HTC options table later.</p>
            </div>

            <div>
              <label className="block text-gray-700 mb-2">Years of experience</label>
              <select
                value={formData.experience_years}
                onChange={(event) => updateField("experience_years", event.target.value)}
                className="w-full border border-gray-300 rounded-xl px-4 h-12 text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#0073aa]"
              >
                <option value="">Please choose an option</option>
                <option value="Less than 1 year">Less than 1 year</option>
                <option value="1-2 years">1-2 years</option>
                <option value="3-4 years">3-4 years</option>
                <option value="5+ years">5+ years</option>
              </select>
            </div>
          </div>
        )}

        {step === 2 && (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-[#00139b] mb-6">Personal Information</h2>

            <div className="grid md:grid-cols-2 gap-4">
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="First name *" value={formData.first_name} onChange={(event) => updateField("first_name", event.target.value)} />
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="Last name *" value={formData.last_name} onChange={(event) => updateField("last_name", event.target.value)} />
            </div>

            <input className="w-full border border-gray-300 rounded-xl px-4 h-12" placeholder="Email *" type="email" value={formData.email} onChange={(event) => updateField("email", event.target.value)} />

            <div className="grid md:grid-cols-2 gap-4">
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="Phone *" value={formData.phone} onChange={(event) => updateField("phone", event.target.value)} />
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="WhatsApp" value={formData.whatsapp} onChange={(event) => updateField("whatsapp", event.target.value)} />
            </div>

            <div className="grid md:grid-cols-2 gap-4">
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="City *" value={formData.city} onChange={(event) => updateField("city", event.target.value)} />
              <input className="border border-gray-300 rounded-xl px-4 h-12" placeholder="State *" value={formData.state} onChange={(event) => updateField("state", event.target.value)} />
            </div>

            <input className="w-full border border-gray-300 rounded-xl px-4 h-12" placeholder="Preferred location" value={formData.preferred_location} onChange={(event) => updateField("preferred_location", event.target.value)} />
          </div>
        )}

        {step === 3 && (
          <div className="space-y-6">
            <h2 className="text-2xl font-bold text-[#00139b] mb-6">Resume & Availability</h2>

            <div>
              <label className="block text-gray-700 mb-2">Are you legally authorized to work in the United States?</label>
              <select
                value={formData.work_authorization}
                onChange={(event) => updateField("work_authorization", event.target.value)}
                className="w-full border border-gray-300 rounded-xl px-4 h-12 text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#0073aa]"
              >
                <option value="">Please choose an option</option>
                <option value="Yes">Yes</option>
                <option value="No">No</option>
                <option value="Prefer to discuss">Prefer to discuss</option>
              </select>
            </div>

            <div>
              <label className="block text-gray-700 mb-2">Availability</label>
              <select
                value={formData.availability}
                onChange={(event) => updateField("availability", event.target.value)}
                className="w-full border border-gray-300 rounded-xl px-4 h-12 text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#0073aa]"
              >
                <option value="">Please choose an option</option>
                <option value="Weekdays">Weekdays</option>
                <option value="Evenings">Evenings</option>
                <option value="Weekends">Weekends</option>
                <option value="Flexible">Flexible</option>
              </select>
            </div>

            <div>
              <label className="block text-gray-700 mb-2">Upload resume or CV</label>
              <input type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" onChange={handleFile} className="w-full border border-gray-300 rounded-xl px-4 py-3" />
            </div>

            <textarea
              className="w-full border border-gray-300 rounded-xl px-4 py-3 min-h-[120px]"
              placeholder="Additional message"
              value={formData.message}
              onChange={(event) => updateField("message", event.target.value)}
            />
          </div>
        )}

        {message && (
          <div className={`mt-6 rounded-xl p-4 text-sm font-medium ${status === "success" ? "bg-green-50 text-green-700" : "bg-red-50 text-red-700"}`}>
            {message}
          </div>
        )}

        <div className="pt-6 flex justify-end">
          {step > 1 && (
            <button type="button" onClick={goBack} className="bg-transparent text-gray-500 px-6 py-3 mr-2 hover:bg-gray-100 rounded-full transition-colors font-medium">
              Back
            </button>
          )}

          {step < 3 ? (
            <button type="button" onClick={goNext} className="bg-[#ff008f] text-white px-8 py-3 rounded-full hover:bg-[#d60078] transition-colors font-medium shadow-md">
              Next
            </button>
          ) : (
            <button type="submit" disabled={status === "submitting"} className="bg-[#ff008f] text-white px-8 py-3 rounded-full hover:bg-[#d60078] transition-colors font-medium shadow-md disabled:opacity-60">
              {status === "submitting" ? "Submitting..." : "Submit Application"}
            </button>
          )}
        </div>
      </form>
    </div>
  )
}

