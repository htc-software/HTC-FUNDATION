# ===========================================
# STRIPE CONFIGURATION
# ===========================================

# Stripe Secret Key (from Stripe Dashboard > Developers > API Keys)
# Use the test key (sk_test_...) for development
# Use the live key (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Publishable Key (from Stripe Dashboard > Developers > API Keys)
# Use the test key (pk_test_...) for development
# Use the live key (pk_live_...) for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Base URL of your application (no trailing slash)
# Development: http://localhost:3000
# Production: https://foundationhtc.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
